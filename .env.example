# Alap URL (e-mailes linkekhez, sitemaphez, OG-hoz)
NEXT_PUBLIC_SITE_URL=https://huzdra.hu

# Mock mód: minden szolgáltató (LLM, zene, hang, fizetés, e-mail) helyettesítő implementációval fut
HUZDRA_MOCK=1
# Mock pipeline: ennyi ms telik el két állapot között (látványos demóhoz)
MOCK_STEP_DELAY_MS=2500
# Mock: QC és előadói jóváhagyás automatikus (amíg nincs admin/előadói felület)
MOCK_AUTO_QC=1
MOCK_AUTO_ARTIST_APPROVAL=1
# Mock adatbázis helye (JSON fájl)
DATA_DIR=.data

# Analitika (csak cookie-hozzájárulás után töltődik be)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Később: Supabase, Stripe/Barion, Resend, LLM/zene/hang szolgáltatók
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
