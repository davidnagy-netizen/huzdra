# ---------------------------------------------------------------- alap
NEXT_PUBLIC_SITE_URL=https://huzdra.hu
# 1 = demó sáv látszik (amíg nincs valódi fizetés bekötve, maradjon 1!)
HUZDRA_MOCK=1

# ---------------------------------------------------------------- Supabase (adatbázis + tárhely + admin belépés)
# Ha mindkettő meg van adva, minden adat és fájl a Supabase-ben él; különben helyi .data mappa.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- biztonság
# admin munkamenet aláírása – min. 32 véletlen karakter (pl. openssl rand -base64 48)
ADMIN_SESSION_SECRET=
# háttérfeldolgozó (/api/cron/worker) védelme – a Vercel Cron automatikusan küldi
CRON_SECRET=
# bejövő szupport e-mail webhook (/api/support/inbound?secret=…)
SUPPORT_INBOUND_SECRET=

# helyi demó admin belépés (csak Supabase NÉLKÜL; Supabase-zel a Supabase Auth + admins tábla dönt)
ADMIN_EMAILS=admin@huzdra.hu
ADMIN_PASSWORD=

# ---------------------------------------------------------------- AI és zene
# Claude: dalszöveg-írás + szupport-elemzés (alapértelmezett modell: claude-opus-5-5)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# zene-API: tanítás + generálás (szerződés: docs/zene-api.md)
MUSIC_API_URL=
MUSIC_API_KEY=

# ---------------------------------------------------------------- analitika (csak cookie-hozzájárulás után)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------- csak helyi demóhoz
DATA_DIR=.data
MOCK_STEP_DELAY_MS=2500
MOCK_TRAINING_SECONDS=20
