 "faqs": [
  {
   "id": "f1",
   "question": "Hogyan működik a „fizetés csak ha kész”?",
   "answer": "Rendeléskor a bankkártyádat csak rögzítjük (zárolás / setup intent) – ekkor még nem vonunk le semmit. A terhelés akkor történik meg, amikor a dalod elkészült és elküldtük neked. Ha bármiért nem tudjuk elkészíteni, a zárolást feloldjuk.",
   "sortOrder": 1
  },
  {
   "id": "f2",
   "question": "Kik énekelnek a dalokban? Lesznek hírességek is?",
   "answer": "A dalokat a Húzdrá! saját hangjai éneklik – mindegyik saját stílussal, a lakodalmas mulatóstól a roma balladáig. A dalok mesterséges intelligencia segítségével készülnek. Hamarosan ismert előadók hivatalos, licencelt hangja is választható lesz – iratkozz fel az előadó kártyáján, és szólunk, amint elérhető.",
   "sortOrder": 2
  },
  {
   "id": "f3",
   "question": "Mennyi idő alatt készül el a dal?",
   "answer": "A választott csomagtól függ: „Még ma” – 1–3 órán belül, „Holnapra” – 24 órán belül, „Ráérős” – 5–7 napon belül. Ha egy dalt munkatársunknak át kell néznie, azt is ezen belül intézzük.",
   "sortOrder": 3
  },
  {
   "id": "f4",
   "question": "Hányszor kérhetek javítást?",
   "answer": "Minden dalhoz 2 ingyenes javítási kör jár: a dal-oldalon egy gombbal kérheted, és leírhatod, mit szeretnél másképp (pl. egy név, egy poén, a tempó). Ha így sem vagy elégedett, az elégedettségi garancia keretében visszaadjuk az árát.",
   "sortOrder": 4
  },
  {
   "id": "f5",
   "question": "Lejátszható a lagziban, a DJ-nél vagy az autóban?",
   "answer": "Persze! MP3-ban töltheted le, ami minden telefonon, laptopon, DJ-pulton és autórádión megy. A dal-oldal linkjét pedig egyszerűen elküldheted a DJ-nek vagy a családi csoportba.",
   "sortOrder": 5
  },
  {
   "id": "f6",
   "question": "Mi van, ha a név kiejtése nem jó?",
